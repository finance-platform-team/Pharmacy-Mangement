# Dataverse: by default the app uses the Dataverse of the environment it is running in
# (taken from the Power Apps context at start-up). Set this only to force another one.
# VITE_DATAVERSE_ORG_URL=https://<org>.crm4.dynamics.com

# Power Automate flow used by the app: the SharePoint attachments flow (its URL is per environment, baked in at build time).
VITE_SP_FILE_FLOW_URL=https://<environment>.environment.api.powerplatform.com:443/powerautomate/...
